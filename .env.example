# Copy to .env for local dev. `shopify app dev` fills the Shopify values itself.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,read_inventory,read_products,read_locations

# Postgres connection string (Railway sets this automatically when a Postgres
# service is linked; locally use any reachable Postgres).
DATABASE_URL=postgresql://user:password@localhost:5432/stockcast

# Shown on the public privacy page and in the App Store listing.
SUPPORT_EMAIL=support@example.com

# Optional: cron expression for the daily sync (server time). Default 04:00.
# SYNC_CRON=0 4 * * *
# Set to 1 to disable the in-process scheduler (e.g. during one-off tasks).
# DISABLE_CRON=0
